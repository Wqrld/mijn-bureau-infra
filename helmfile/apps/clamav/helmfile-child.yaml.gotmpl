bases:
  - "../../bases/child-environments.yaml"

---

bases:
  - "../../bases/default.yaml.gotmpl"

releases:
  - name: clamav
    labels:
      tier: app
    chart: charts/clamav
    condition: application.clamav.enabled
    {{- if .Values.application.clamav.namespace }}
    namespace: {{ .Values.application.clamav.namespace }}
    {{- end }}
    values:
      - "values.yaml.gotmpl"
